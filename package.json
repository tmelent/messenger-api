{
  "name": "api",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "start": "ts-node src/main.ts",
    "start:dev": "nest start --watch",
    "test": "jest",
    "build": "tsc",
    "start:prod": "node dist/main.js",
    "lint": "eslint 'src/**/*.{ts,js}' --fix",
    "typeorm": "ts-node -r tsconfig-paths/register ./node_modules/typeorm/cli",
    "migration:generate": "npm run typeorm -- migration:generate -d ./src/modules/config/data-source.ts",
    "migration:run": "npm run typeorm -- migration:run -d ./src/modules/config/data-source.ts",
    "migration:revert": "npm run typeorm -- migration:revert -d ./src/modules/config/data-source.ts",
    "migration:show": "npm run typeorm -- migration:show -d ./src/modules/config/data-source.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "dependencies": {
    "@nestjs/common": "11.0.12",
    "@nestjs/config": "4.0.1",
    "@nestjs/core": "11.0.11",
    "@nestjs/jwt": "11.0.0",
    "@nestjs/passport": "11.0.5",
    "@nestjs/platform-express": "11.0.11",
    "@nestjs/platform-socket.io": "11.0.12",
    "@nestjs/testing": "11.0.12",
    "@nestjs/typeorm": "11.0.0",
    "@nestjs/websockets": "11.0.11",
    "@types/passport-local": "1.0.38",
    "argon2": "0.41.1",
    "class-transformer": "0.5.1",
    "class-validator": "0.14.1",
    "express-session": "1.18.1",
    "module": "1.2.5",
    "passport": "0.7.0",
    "passport-jwt": "4.0.1",
    "passport-local": "1.0.0",
    "pg": "8.14.0",
    "reflect-metadata": "0.2.2",
    "socket.io": "4.8.1",
    "typeorm": "0.3.21",
    "typeorm-naming-strategies": "4.1.0"
  },
  "devDependencies": {
    "@eslint/js": "9.22.0",
    "@nestjs/cli": "11.0.5",
    "@types/jest": "29.5.14",
    "@types/node": "22.13.10",
    "@types/passport-jwt": "4.0.1",
    "@typescript-eslint/eslint-plugin": "8.26.1",
    "@typescript-eslint/parser": "8.26.1",
    "eslint": "9.22.0",
    "eslint-plugin-import": "2.31.0",
    "globals": "16.0.0",
    "jest": "29.7.0",
    "ts-jest": "29.3.1",
    "ts-node": "10.9.2",
    "typescript": "5.8.2",
    "typescript-eslint": "8.26.1"
  }
